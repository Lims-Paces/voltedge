# Copy this file to .env.local and fill in the values.
# On Vercel: Project → Settings → Environment Variables (add each one).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # server only, never share

# n8n → open the "VoltEdge · 01 Order Intake" workflow → Webhook node → Production URL
N8N_ORDER_WEBHOOK_URL=https://your-name.app.n8n.cloud/webhook/voltedge-order
N8N_WEBHOOK_SECRET=make-up-a-long-random-string  # must match the Header Auth credential in n8n

# Paystack → Settings → API Keys & Webhooks (TEST secret key)
PAYSTACK_SECRET_KEY=sk_test_...

# Your deployed site, no trailing slash (http://localhost:3000 when running locally)
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app
